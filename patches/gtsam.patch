 #include <algorithm>
 #include <map>
 #include <utility>
+#include <stdexcept>
 
 using namespace std;
 
 namespace gtsam {
+
+void ISAM2::backup() {
+  ltaom_snapshot_.reset();
+  ltaom_snapshot_.reset(new ISAM2(*this));
+}
+
+void ISAM2::recover() {
+  if (!ltaom_snapshot_) throw std::logic_error("ISAM2::recover without backup");
+  const boost::shared_ptr<ISAM2> snapshot = ltaom_snapshot_;
+  *this = *snapshot;
+  ltaom_snapshot_ = snapshot;
+}
 
 // Instantiate base class
 template class BayesTree<ISAM2Clique>;
