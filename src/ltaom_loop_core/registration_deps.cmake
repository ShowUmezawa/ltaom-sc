# Build pinned sources locally, without upstream configure-time network downloads.
find_package(OpenMP REQUIRED)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
file(GLOB PMC_SRC "${D2_DEPS_DIR}/pmc/pmc_*.cpp" "${D2_DEPS_DIR}/pmc/pmcx_*.cpp")
list(FILTER PMC_SRC EXCLUDE REGEX "pmc_driver.cpp")
add_library(d2_pmc STATIC ${PMC_SRC})
target_include_directories(d2_pmc PUBLIC ${D2_DEPS_DIR}/pmc/include ${D2_DEPS_DIR}/pmc)
target_link_libraries(d2_pmc PUBLIC OpenMP::OpenMP_CXX)
add_library(d2_teaser STATIC ${D2_DEPS_DIR}/teaserpp/teaser/src/registration.cc ${D2_DEPS_DIR}/teaserpp/teaser/src/graph.cc)
target_include_directories(d2_teaser PUBLIC ${D2_DEPS_DIR}/teaserpp/teaser/include)
target_link_libraries(d2_teaser PUBLIC d2_pmc OpenMP::OpenMP_CXX)
add_library(d2_quatro STATIC ${D2_DEPS_DIR}/quatro/src/fpfh.cc ${D2_DEPS_DIR}/quatro/src/matcher.cc ${D2_DEPS_DIR}/quatro/src/quatro_module.cc)
target_include_directories(d2_quatro PUBLIC ${D2_DEPS_DIR}/quatro/include)
target_compile_definitions(d2_quatro PRIVATE TBB_EN TBB_PROC_NUM=2)
target_link_libraries(d2_quatro PUBLIC d2_teaser ${PCL_LIBRARIES} tbb OpenMP::OpenMP_CXX)
add_library(d2_nano STATIC ${D2_DEPS_DIR}/nano_gicp/src/nanoflann.cc ${D2_DEPS_DIR}/nano_gicp/src/nano_gicp.cc)
target_include_directories(d2_nano PUBLIC ${D2_DEPS_DIR}/nano_gicp/include)
target_link_libraries(d2_nano PUBLIC ${PCL_LIBRARIES} OpenMP::OpenMP_CXX)
add_executable(registration src/registration.cpp)
target_link_libraries(registration d2_nano d2_quatro ${PCL_LIBRARIES})
target_compile_options(d2_teaser PRIVATE -include ${CMAKE_CURRENT_SOURCE_DIR}/src/teaser_compat.hpp)
